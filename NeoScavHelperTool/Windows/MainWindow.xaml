<mah:MetroWindow
  x:Name="metroWindow"
  x:Class="NeoScavHelperTool.Views.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
  xmlns:views="clr-namespace:NeoScavHelperTool.Views"
  xmlns:converters="clr-namespace:NeoScavHelperTool.Converters"
  xmlns:behaviors="clr-namespace:NeoScavHelperTool.Behaviors"
  xmlns:bindingProxies="clr-namespace:NeoScavHelperTool.BindingProxies"
  xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Material"
  xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
  mc:Ignorable="d"
  Title="NeoScavHelperTool"
  MinWidth="1024"
  MinHeight="768"
  WindowState="Maximized"
  mah:TitleCharacterCasing="Normal"
  SnapsToDevicePixels="True"
  mah:ResizeMode="CanResizeWithGrip"
  DataContext="{Binding HamburgerPaneViewModel, Source={StaticResource ViewModelLocator}}"
>
  <mah:MetroWindow.Resources>
    <converters:NotEqualConverter x:Key="NotEqualConverter" />
    <converters:SumConverter x:Key="SumConverter" />
  </mah:MetroWindow.Resources>
  <mah:HamburgerMenu
    x:Name="ViewerHamburgerMenu"
    DisplayMode="CompactOverlay"
    IsPaneOpen="True"
    HamburgerWidth="48"
    DataContext="{Binding HamburgerPaneViewModel, Source={StaticResource ViewModelLocator}}"
    ItemsSource="{Binding HamburgerItems}"
    MaximumOpenPaneLength="800"
    MinimumOpenPaneLength="300"
  >
    <!--  Header  -->
    <mah:HamburgerMenu.HamburgerMenuHeaderTemplate>
      <DataTemplate>
        <DockPanel>
          <DockPanel.Resources>
            <Style
              BasedOn="{StaticResource MahApps.Styles.ComboBox}"
              TargetType="{x:Type ComboBox}"
            >
              <Setter
                Property="Background"
                Value="{DynamicResource MahApps.HamburgerMenu.Pane.Background}"
              />
            </Style>
            <Style
              BasedOn="{StaticResource MahApps.Styles.ComboBoxItem}"
              TargetType="{x:Type ComboBoxItem}"
            >
              <Setter
                Property="Background"
                Value="{DynamicResource MahApps.HamburgerMenu.Pane.Background}"
              />
            </Style>
          </DockPanel.Resources>
          <Label
            Content="_Display:"
            VerticalAlignment="Center"
            Target="{Binding ElementName=DisplayModeComboBox}"
          />
          <ComboBox
            x:Name="DisplayModeComboBox"
            VerticalAlignment="Center"
            Margin="6,0"
            DataContext="{Binding ElementName=ViewerHamburgerMenu, Path=DataContext}"
            SelectedIndex="{Binding DisplayMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          >
            <ComboBoxItem Content="by Mod" />
            <ComboBoxItem Content="by Type (WIP)" />
            <ComboBoxItem Content="Consolidated (WIP)" />
          </ComboBox>
        </DockPanel>
      </DataTemplate>
    </mah:HamburgerMenu.HamburgerMenuHeaderTemplate>
    <mah:HamburgerMenu.Resources>
      <bindingProxies:HamburgerMenuBindingProxy
        x:Key="ViewerHamburgerMenuProxy"
        Data="{Binding ElementName=ViewerHamburgerMenu}"
      />
      <Style
        BasedOn="{StaticResource MahApps.Styles.HamburgerMenuListBox}"
        TargetType="{x:Type mah:HamburgerMenuListBox}"
      >
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type mah:HamburgerMenuListBox}">
              <Grid>
                <!-- Original template -->
                <Border
                  Name="OptionItemsBorder"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                >
                  <ScrollViewer
                    Padding="{TemplateBinding Padding}"
                    mah:ScrollViewerHelper.VerticalScrollBarOnLeftSide="{TemplateBinding mah:ScrollViewerHelper.VerticalScrollBarOnLeftSide}"
                    CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                    Focusable="False"
                    HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                    Style="{StaticResource MahApps.Styles.ScrollViewer.Hamburger}"
                    VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                  >
                    <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                  </ScrollViewer>
                </Border>
                <!-- Custom template -->
                <Border
                  Name="ItemsBorder"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                >
                  <DockPanel LastChildFill="True">
                    <DockPanel.Resources>
                      <Style
                        BasedOn="{StaticResource MahApps.Styles.Expander}"
                        TargetType="{x:Type Expander}"
                      >
                        <Style.Triggers>
                          <DataTrigger
                            Binding="{Binding Content.HasItems, RelativeSource={RelativeSource Self}}"
                            Value="False"
                          >
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                      <Style
                        BasedOn="{StaticResource MahApps.Styles.ListBox}"
                        TargetType="{x:Type ListBox}"
                      >
                        <Setter
                          Property="Background"
                          Value="{DynamicResource MahApps.HamburgerMenu.Pane.Background}"
                        />
                      </Style>
                      <Style
                        BasedOn="{StaticResource MahApps.Styles.ListBoxItem}"
                        TargetType="{x:Type ListBoxItem}"
                      >
                        <Setter
                          Property="Background"
                          Value="{DynamicResource MahApps.HamburgerMenu.Pane.Background}"
                        />
                      </Style>
                    </DockPanel.Resources>
                    <Expander
                      x:Name="FirstExpander"
                      ExpandDirection="Right"
                      HorizontalAlignment="Left"
                      Margin="3,0,6,0"
                      DockPanel.Dock="Right"
                      IsExpanded="{Binding IsFirstExpanderExtended, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    >
                      <i:Interaction.Behaviors>
                        <behaviors:ExpanderDesiredWidthBehavior DesiredWidth="{Binding FirstExpanderDesiredWidth, Source={StaticResource ViewerHamburgerMenuProxy}, Mode=OneWayToSource}" />
                      </i:Interaction.Behaviors>
                      <Expander.Header>
                        <!-- for some reason I had to bind the Content because he is the one acting as DataContext in Framework 462 at least -->
                        <ContentPresenter
                          Content="{Binding DataContext, ElementName=ViewerHamburgerMenu}"
                          DataContext="{Binding DataContext, ElementName=ViewerHamburgerMenu}"
                        >
                          <ContentPresenter.ContentTemplate>
                            <DataTemplate>
                              <StackPanel
                                RenderTransformOrigin="0.5,0.5"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                              >
                                <StackPanel.LayoutTransform>
                                  <RotateTransform Angle="-90" />
                                </StackPanel.LayoutTransform>
                                <StackPanel x:Name="ShowStack" Orientation="Horizontal">
                                  <iconPacks:PackIconMaterial
                                    Kind="ArrowUp"
                                    Width="{Binding ElementName=ShowText, Path=ActualHeight, Mode=OneWay}"
                                    Height="{Binding ElementName=ShowText, Path=ActualHeight, Mode=OneWay}"
                                  />
                                  <TextBlock
                                    x:Name="ShowText"
                                    Margin="6,0"
                                    Text="{Binding FirstExpanderHeaderShowText}"
                                    FontSize="16"
                                    VerticalAlignment="Center"
                                  ></TextBlock>
                                  <iconPacks:PackIconMaterial
                                    Kind="ArrowUp"
                                    Width="{Binding ElementName=ShowText, Path=ActualHeight, Mode=OneWay}"
                                    Height="{Binding ElementName=ShowText, Path=ActualHeight, Mode=OneWay}"
                                  />
                                </StackPanel>
                                <TextBlock
                                  x:Name="OrText"
                                  FontSize="16"
                                  Margin="6,0"
                                  Text="OR"
                                ></TextBlock>
                                <StackPanel x:Name="ChooseStack" Orientation="Horizontal">
                                  <iconPacks:PackIconMaterial
                                    Kind="ArrowDown"
                                    Width="{Binding ElementName=ChooseText, Path=ActualHeight, Mode=OneWay}"
                                    Height="{Binding ElementName=ChooseText, Path=ActualHeight, Mode=OneWay}"
                                  />
                                  <TextBlock
                                    x:Name="ChooseText"
                                    FontSize="16"
                                    Margin="6,0"
                                    Text="{Binding FirstExpanderHeaderChooseText}"
                                    VerticalAlignment="Center"
                                  ></TextBlock>
                                  <iconPacks:PackIconMaterial
                                    Kind="ArrowDown"
                                    Width="{Binding ElementName=ChooseText, Path=ActualHeight, Mode=OneWay}"
                                    Height="{Binding ElementName=ChooseText, Path=ActualHeight, Mode=OneWay}"
                                  />
                                </StackPanel>
                              </StackPanel>
                              <DataTemplate.Triggers>
                                <DataTrigger
                                  Binding="{Binding IsExpanded, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Expander}}}"
                                  Value="False"
                                >
                                  <Setter
                                    TargetName="OrText"
                                    Property="Visibility"
                                    Value="Collapsed"
                                  />
                                </DataTrigger>
                                <DataTrigger
                                  Binding="{Binding IsExpanded, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Expander}}}"
                                  Value="True"
                                >
                                  <Setter
                                    TargetName="ChooseStack"
                                    Property="Visibility"
                                    Value="Visible"
                                  />
                                </DataTrigger>
                                <MultiDataTrigger>
                                  <MultiDataTrigger.Conditions>
                                    <Condition
                                      Binding="{Binding IsExpanded, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Expander}}}"
                                      Value="False"
                                    />
                                    <Condition
                                      Binding="{Binding Content.SelectedIndex, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Expander}}, Converter={StaticResource NotEqualConverter}, ConverterParameter=-1}"
                                      Value="True"
                                    />
                                  </MultiDataTrigger.Conditions>
                                  <Setter
                                    TargetName="ChooseStack"
                                    Property="Visibility"
                                    Value="Collapsed"
                                  />
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                  <MultiDataTrigger.Conditions>
                                    <Condition
                                      Binding="{Binding IsExpanded, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Expander}}}"
                                      Value="True"
                                    />
                                    <Condition
                                      Binding="{Binding Content.SelectedIndex, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Expander}}, Converter={StaticResource NotEqualConverter}, ConverterParameter=-1}"
                                      Value="True"
                                    />
                                  </MultiDataTrigger.Conditions>
                                  <Setter
                                    TargetName="OrText"
                                    Property="Visibility"
                                    Value="Visible"
                                  />
                                </MultiDataTrigger>
                                <DataTrigger
                                  Binding="{Binding Content.SelectedIndex, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Expander}}}"
                                  Value="-1"
                                >
                                  <Setter
                                    TargetName="OrText"
                                    Property="Visibility"
                                    Value="Collapsed"
                                  />
                                  <Setter
                                    TargetName="ShowStack"
                                    Property="Visibility"
                                    Value="Collapsed"
                                  />
                                </DataTrigger>
                              </DataTemplate.Triggers>
                            </DataTemplate>
                          </ContentPresenter.ContentTemplate>
                        </ContentPresenter>
                      </Expander.Header>
                      <Expander.Content>
                        <ListBox
                          x:Name="FirstExpanderListBox"
                          SelectedIndex="{Binding ChosenFirstExpanderIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        />
                      </Expander.Content>
                    </Expander>
                    <Expander
                      x:Name="SecondExpander"
                      ExpandDirection="Right"
                      HorizontalAlignment="Left"
                      Margin="6,0,3,0"
                      DockPanel.Dock="Right"
                      IsExpanded="{Binding IsSecondExpanderExtended, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    >
                      <i:Interaction.Behaviors>
                        <behaviors:ExpanderDesiredWidthBehavior DesiredWidth="{Binding SecondExpanderDesiredWidth, Source={StaticResource ViewerHamburgerMenuProxy}, Mode=OneWayToSource}" />
                      </i:Interaction.Behaviors>
                      <Expander.Header>
                        <!-- for some reason I had to bind the Content because he is the one acting as DataContext in Framework 462 at least -->
                        <ContentPresenter
                          Content="{Binding DataContext, ElementName=ViewerHamburgerMenu}"
                          DataContext="{Binding DataContext, ElementName=ViewerHamburgerMenu}"
                        >
                          <ContentPresenter.ContentTemplate>
                            <DataTemplate>
                              <StackPanel
                                RenderTransformOrigin="0.5,0.5"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                              >
                                <StackPanel.LayoutTransform>
                                  <RotateTransform Angle="-90" />
                                </StackPanel.LayoutTransform>
                                <StackPanel x:Name="ShowStack" Orientation="Horizontal">
                                  <iconPacks:PackIconMaterial
                                    Kind="ArrowUp"
                                    Width="{Binding ElementName=ShowText, Path=ActualHeight, Mode=OneWay}"
                                    Height="{Binding ElementName=ShowText, Path=ActualHeight, Mode=OneWay}"
                                  />
                                  <TextBlock
                                    x:Name="ShowText"
                                    Margin="6,0"
                                    Text="{Binding SecondExpanderHeaderShowText}"
                                    FontSize="16"
                                    VerticalAlignment="Center"
                                  ></TextBlock>
                                  <iconPacks:PackIconMaterial
                                    Kind="ArrowUp"
                                    Width="{Binding ElementName=ShowText, Path=ActualHeight, Mode=OneWay}"
                                    Height="{Binding ElementName=ShowText, Path=ActualHeight, Mode=OneWay}"
                                  />
                                </StackPanel>
                                <TextBlock
                                  x:Name="OrText"
                                  FontSize="16"
                                  Margin="6,0"
                                  Text="OR"
                                ></TextBlock>
                                <StackPanel x:Name="ChooseStack" Orientation="Horizontal">
                                  <iconPacks:PackIconMaterial
                                    Kind="ArrowDown"
                                    Width="{Binding ElementName=ChooseText, Path=ActualHeight, Mode=OneWay}"
                                    Height="{Binding ElementName=ChooseText, Path=ActualHeight, Mode=OneWay}"
                                  />
                                  <TextBlock
                                    x:Name="ChooseText"
                                    FontSize="16"
                                    Margin="6,0"
                                    Text="{Binding SecondExpanderHeaderChooseText}"
                                    VerticalAlignment="Center"
                                  ></TextBlock>
                                  <iconPacks:PackIconMaterial
                                    Kind="ArrowDown"
                                    Width="{Binding ElementName=ChooseText, Path=ActualHeight, Mode=OneWay}"
                                    Height="{Binding ElementName=ChooseText, Path=ActualHeight, Mode=OneWay}"
                                  />
                                </StackPanel>
                              </StackPanel>
                              <DataTemplate.Triggers>
                                <DataTrigger
                                  Binding="{Binding IsExpanded, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Expander}}}"
                                  Value="False"
                                >
                                  <Setter
                                    TargetName="OrText"
                                    Property="Visibility"
                                    Value="Collapsed"
                                  />
                                </DataTrigger>
                                <DataTrigger
                                  Binding="{Binding IsExpanded, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Expander}}}"
                                  Value="True"
                                >
                                  <Setter
                                    TargetName="ChooseStack"
                                    Property="Visibility"
                                    Value="Visible"
                                  />
                                </DataTrigger>
                                <MultiDataTrigger>
                                  <MultiDataTrigger.Conditions>
                                    <Condition
                                      Binding="{Binding IsExpanded, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Expander}}}"
                                      Value="False"
                                    />
                                    <Condition
                                      Binding="{Binding Content.SelectedIndex, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Expander}}, Converter={StaticResource NotEqualConverter}, ConverterParameter=-1}"
                                      Value="True"
                                    />
                                  </MultiDataTrigger.Conditions>
                                  <Setter
                                    TargetName="ChooseStack"
                                    Property="Visibility"
                                    Value="Collapsed"
                                  />
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                  <MultiDataTrigger.Conditions>
                                    <Condition
                                      Binding="{Binding IsExpanded, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Expander}}}"
                                      Value="True"
                                    />
                                    <Condition
                                      Binding="{Binding Content.SelectedIndex, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Expander}}, Converter={StaticResource NotEqualConverter}, ConverterParameter=-1}"
                                      Value="True"
                                    />
                                  </MultiDataTrigger.Conditions>
                                  <Setter
                                    TargetName="OrText"
                                    Property="Visibility"
                                    Value="Visible"
                                  />
                                </MultiDataTrigger>
                                <DataTrigger
                                  Binding="{Binding Content.SelectedIndex, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Expander}}}"
                                  Value="-1"
                                >
                                  <Setter
                                    TargetName="OrText"
                                    Property="Visibility"
                                    Value="Collapsed"
                                  />
                                  <Setter
                                    TargetName="ShowStack"
                                    Property="Visibility"
                                    Value="Collapsed"
                                  />
                                </DataTrigger>
                              </DataTemplate.Triggers>
                            </DataTemplate>
                          </ContentPresenter.ContentTemplate>
                        </ContentPresenter>
                      </Expander.Header>
                      <Expander.Content>
                        <ListBox
                          x:Name="SecondExpanderListBox"
                          SelectedIndex="{Binding ChosenSecondExpanderIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          SelectionChanged="Expanders_SelectionChanged"
                        />
                      </Expander.Content>
                    </Expander>
                    <ScrollViewer
                      mah:ScrollViewerHelper.VerticalScrollBarOnLeftSide="{TemplateBinding mah:ScrollViewerHelper.VerticalScrollBarOnLeftSide}"
                      CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                      Focusable="False"
                      HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                      Style="{StaticResource MahApps.Styles.ScrollViewer.Hamburger}"
                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                      Padding="0,0,14,0"
                      DockPanel.Dock="Left"
                    >
                      <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </ScrollViewer>
                  </DockPanel>
                </Border>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="Name" Value="ButtonsListView">
                  <Setter TargetName="OptionItemsBorder" Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="Name" Value="OptionsListView">
                  <Setter TargetName="ItemsBorder" Property="Visibility" Value="Collapsed" />
                </Trigger>
                <MultiTrigger>
                  <MultiTrigger.Conditions>
                    <Condition Property="IsGrouping" Value="true" />
                    <Condition
                      Property="VirtualizingPanel.IsVirtualizingWhenGrouping"
                      Value="false"
                    />
                  </MultiTrigger.Conditions>
                  <Setter Property="ScrollViewer.CanContentScroll" Value="false" />
                </MultiTrigger>
                <!-- Handling Display Mode Combobox changes -->
                <DataTrigger Binding="{Binding DisplayMode}" Value="0">
                  <Setter
                    TargetName="FirstExpanderListBox"
                    Property="ItemsSource"
                    Value="{Binding Mods}"
                  />
                </DataTrigger>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding DisplayMode}" Value="0" />
                    <Condition
                      Binding="{Binding SelectedIndex, ElementName=FirstExpanderListBox, ConverterParameter=-1, Converter={StaticResource NotEqualConverter}}"
                      Value="True"
                    />
                  </MultiDataTrigger.Conditions>
                  <Setter
                    TargetName="SecondExpanderListBox"
                    Property="ItemsSource"
                    Value="{Binding SelectedModTypes}"
                  />
                </MultiDataTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </mah:HamburgerMenu.Resources>
    <mah:HamburgerMenu.ItemTemplate>
      <DataTemplate>
        <DockPanel
          Height="{Binding RelativeSource={RelativeSource AncestorType={x:Type mah:HamburgerMenu}}, Path=CompactPaneLength}"
          LastChildFill="True"
          ToolTip="{Binding DisplayName}"
          Background="#00000000"
        >
          <Grid
            Width="{Binding RelativeSource={RelativeSource AncestorType={x:Type mah:HamburgerMenu}}, Path=CompactPaneLength}"
            DockPanel.Dock="Left"
          >
            <TextBlock
              FontSize="16"
              Text="{Binding Identifier}"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              TextTrimming="CharacterEllipsis"
            />
          </Grid>
          <TextBlock
            Text="{Binding DisplayName}"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Margin="6,0"
            TextTrimming="CharacterEllipsis"
          />
        </DockPanel>
      </DataTemplate>
    </mah:HamburgerMenu.ItemTemplate>
    <!--  Options  -->
    <mah:HamburgerMenu.OptionsItemTemplate>
      <DataTemplate>
        <DockPanel
          Height="{Binding RelativeSource={RelativeSource AncestorType={x:Type mah:HamburgerMenu}}, Path=CompactPaneLength}"
          LastChildFill="True"
        >
          <TextBlock
            x:Name="TextPart"
            VerticalAlignment="Center"
            FontSize="16"
            Text="{Binding Label}"
          />
        </DockPanel>
      </DataTemplate>
    </mah:HamburgerMenu.OptionsItemTemplate>
    <i:Interaction.Behaviors>
      <behaviors:AdaptivePaneWidthBehavior x:Name="AdaptivePaneWidthBehaviorInstance" />
    </i:Interaction.Behaviors>
    <mah:HamburgerMenu.OpenPaneLength>
      <MultiBinding Converter="{StaticResource SumConverter}">
        <Binding
          Path="FirstExpanderDesiredWidth"
          Source="{StaticResource ViewerHamburgerMenuProxy}"
        />
        <Binding
          Path="SecondExpanderDesiredWidth"
          Source="{StaticResource ViewerHamburgerMenuProxy}"
        />
        <Binding Path="DesiredMaxWidth" Source="{x:Reference AdaptivePaneWidthBehaviorInstance}" />
        <Binding Path="HamburgerWidth" ElementName="ViewerHamburgerMenu" />
      </MultiBinding>
    </mah:HamburgerMenu.OpenPaneLength>
  </mah:HamburgerMenu>
</mah:MetroWindow>
